<?xml version="1.0"?>
<ruleset name="Usage Statistics Client">
    <description>PSR-12 coding standard for the Usage Statistics Client.</description>
    <file>src</file>
    <file>tests</file>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="warning-severity" value="0"/>
    <rule ref="PSR12"/>
</ruleset>
