{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.2/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "phpUnit": {
        "configDir": ".",
        "customPath": "vendor/bin/phpunit"
    },
    "minMsi": 95,
    "minCoveredMsi": 95,
    "mutators": {
        "@default": true
    }
}
